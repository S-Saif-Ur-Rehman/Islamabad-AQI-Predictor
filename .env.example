# Copy this file to .env and fill it in.
# Do not commit the real .env file.
# In GitHub Actions, use repo secrets and variables.

# City settings
CITY_NAME=Islamabad
LATITUDE=33.6844
LONGITUDE=73.0479
# Fallback AQICN station slug.
AQICN_CITY_SLUG=pakistan/islamabad/us-embassy

# API keys
AQICN_API_TOKEN=your_aqicn_token_here
OPENWEATHER_API_KEY=your_openweather_key_here

# Feature store and model registry
# Keep this off for the local parquet setup.
USE_HOPSWORKS=false
HOPSWORKS_API_KEY=
HOPSWORKS_PROJECT_NAME=

# Alerts
AQI_ALERT_THRESHOLD=150
API_AUTH_TOKEN=
MAX_BACKFILL_DAYS=730
