# Streamlit Community Cloud secrets template — SINGLE-TIER ("streamlit-only") deployment.
#
# This is the config for the `streamlit-only-deployment` branch: the dashboard runs
# inference in-process (reads Hopsworks directly, loads the model, computes SHAP) and
# never calls a Flask API. Leave API_URL unset/absent — that's what keeps the dashboard
# on its local-fallback path (see API_URL check in dashboard/app.py).
#
# Copy the values below into your Streamlit Cloud app's Settings -> Secrets panel.
# Do NOT commit a real `secrets.toml` — it's already gitignored.

USE_HOPSWORKS = "true"
HOPSWORKS_API_KEY = "your_hopsworks_api_key"
HOPSWORKS_PROJECT_NAME = "AQIpredictor7"
CITY_NAME = "Islamabad"
LATITUDE = "33.6844"
LONGITUDE = "73.0479"
AQICN_CITY_SLUG = "pakistan/islamabad/us-embassy"
