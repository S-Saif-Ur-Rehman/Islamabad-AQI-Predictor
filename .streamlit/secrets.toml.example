# Streamlit Community Cloud secrets template — TWO-TIER ("render+streamlit") deployment.
#
# This is the config for the `master` branch: the Flask API runs as its own service on
# Render (see render.yaml), and the Streamlit dashboard calls it over HTTP via API_URL.
# The dashboard still falls back to local Hopsworks reads if the API call fails.
#
# Copy the values below into your Streamlit Cloud app's Settings -> Secrets panel.
# Do NOT commit a real `secrets.toml` — it's already gitignored.

USE_HOPSWORKS = "true"
HOPSWORKS_API_KEY = "your_hopsworks_api_key"
HOPSWORKS_PROJECT_NAME = "AQIpredictor7"
CITY_NAME = "Islamabad"
LATITUDE = "33.6844"
LONGITUDE = "73.0479"
AQICN_CITY_SLUG = "pakistan/islamabad/us-embassy"

# Two-tier mode: point at the Flask API hosted on Render.
API_URL = "https://your-render-service.onrender.com"
API_AUTH_TOKEN = "your_api_auth_token_here"   # must match API_AUTH_TOKEN set on the Render service
